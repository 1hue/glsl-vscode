{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}"],
			"outFiles": ["${workspaceFolder}/out/src/**/*.js"],
			"preLaunchTask": "compile"
		},
		{
			"name": "Build VSIX",
			"type": "node-terminal",
			"request": "launch",
			"command": "make build"
		}
	]
}
